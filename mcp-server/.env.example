# ==============================================================================
# GEO Auditor — Model Context Protocol (MCP) Server Environment Template
# ==============================================================================

# Port for the MCP server HTTP transport (SSE & Streamable HTTP)
# Default: 3001
MCP_PORT=3001

# Base URL of the GEO Auditor backend REST API
# The MCP server forwards brand visibility checks to this endpoint.
# Default: http://localhost:3000
GEO_AUDITOR_API_URL=http://localhost:3000

# Optional default SerpApi key for live Google AI Overview/AI Mode audits.
# If omitted here, the server automatically checks server/.env or falls back to
# sandbox demo mode when callers do not supply their own serpapi_key parameter.
# Get a key at: https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here
