# ==========================================
# GEO Auditor — Server Environment Template
# ==========================================

# Server Port (default: 3000)
PORT=3000

# Get your free API key at https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here

# PostgreSQL connection string (Neon, Supabase, or local PostgreSQL)
DATABASE_URL=postgresql://localhost:5432/geo_auditor
